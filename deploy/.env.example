# Copy into Portainer's stack environment (it is written to stack.env).

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me-too

# Public address of the guest page (your subdomain in Nginx Proxy Manager).
# Leave empty to use the address you open /manage/ with. Set it if you manage
# Vitrine through another address (e.g. the Tailscale IP) than the one guests use.
VITRINE_PUBLIC_URL=
DJANGO_ALLOWED_HOSTS=*
# Only needed if logging in to /manage/ fails with a CSRF error behind your proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=

# First admin login for /manage/ (created on first start).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=change-me-as-well

# Frame rate of your vMix project. Videos are converted to it.
VITRINE_VIDEO_FPS=25
# Seconds between filmstrip frames in the cue panel.
VITRINE_FILMSTRIP_INTERVAL=5
# Largest upload in MB, and days a deleted file stays in the trash.
VITRINE_MAX_UPLOAD_MB=4096
VITRINE_TRASH_DAYS=30

# Port the agent uses over Tailscale, and the address it binds to (your server's Tailscale IP).
VITRINE_TAILSCALE_PORT=8080
VITRINE_BIND=0.0.0.0

TZ=Europe/Zurich

# Docker network Nginx Proxy Manager is on
VITRINE_PROXY_NETWORK=proxy

# ---------- Alerts to the team ----------
# Easier: leave these empty and set them in /manage/ → Settings (bot token, Brevo or other SMTP);
# each organization then connects its Telegram chat under Organization → Connect Telegram.
# Telegram bot from @BotFather
VITRINE_TELEGRAM_BOT_TOKEN=
# Email over SMTP (leave EMAIL_HOST empty for no email)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
# Minutes without contact before a vMix PC counts as offline; time of the "ready for tomorrow?" check
VITRINE_OFFLINE_ALERT_MINUTES=10
VITRINE_SYNC_CHECK_TIME=18:00

# ---------- Backups (database + media + pairing key, every night) ----------
# Empty = off. Examples (configure the remote with the RCLONE_CONFIG_… lines below):
#   /backup                  folder mounted into the scheduler container (see docker-compose.yml)
#   s3:vitrine-backup        S3-compatible bucket
#   azure:vitrine            Azure Blob container
#   ftp:backups/vitrine      FTP;  sftp:backups/vitrine  SFTP;  nas:share/vitrine  SMB share
VITRINE_BACKUP_TARGET=
VITRINE_BACKUP_TIME=03:30
VITRINE_BACKUP_KEEP_DAYS=14

# S3-compatible (Hetzner Object Storage, AWS, MinIO, Wasabi, Backblaze B2 S3 …)
# RCLONE_CONFIG_S3_TYPE=s3
# RCLONE_CONFIG_S3_PROVIDER=Other
# RCLONE_CONFIG_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# RCLONE_CONFIG_S3_ACCESS_KEY_ID=
# RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
# Azure Blob
# RCLONE_CONFIG_AZURE_TYPE=azureblob
# RCLONE_CONFIG_AZURE_ACCOUNT=
# RCLONE_CONFIG_AZURE_KEY=
# FTP (password must be obscured: docker run --rm rclone/rclone obscure 'yourpassword')
# RCLONE_CONFIG_FTP_TYPE=ftp
# RCLONE_CONFIG_FTP_HOST=
# RCLONE_CONFIG_FTP_USER=
# RCLONE_CONFIG_FTP_PASS=
# RCLONE_CONFIG_FTP_EXPLICIT_TLS=true
# SMB / Windows share / NAS (password obscured as for FTP)
# RCLONE_CONFIG_NAS_TYPE=smb
# RCLONE_CONFIG_NAS_HOST=192.168.1.20
# RCLONE_CONFIG_NAS_USER=
# RCLONE_CONFIG_NAS_PASS=
