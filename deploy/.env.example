# Variables for the Portainer stack (Stacks → the stack → Environment variables, or
# "Load variables from .env file"). Only the uncommented lines are needed.
# Telegram, email (e.g. Brevo) and backups are NOT set here: set them in /manage/ → Settings,
# then connect each organization's Telegram chat under Organization → Connect Telegram.

# ---------- Required ----------
# Password of the database. Choose it once and keep it: the database is created with it
# on the first start, and changing it here later locks Vitrine out of its own data.
POSTGRES_PASSWORD=change-me-too

# First admin login for /manage/ (created on the first start only; afterwards change
# passwords under My account and add your team under Team).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=change-me-as-well

# ---------- Your server ----------
# Public address of the guest pages (your subdomain in Nginx Proxy Manager), e.g.
# https://vitrine.example.org. Empty: guest links use the address you open /manage/ with.
VITRINE_PUBLIC_URL=
# Docker network Nginx Proxy Manager is on.
VITRINE_PROXY_NETWORK=proxy
# Port the agent uses over Tailscale, and the address it binds to (your server's Tailscale IP
# keeps it off the internet, e.g. 100.101.102.103).
VITRINE_TAILSCALE_PORT=8080
VITRINE_BIND=0.0.0.0
TZ=Europe/Zurich

# ---------- Optional (defaults shown; uncomment only to change) ----------
# Signs sign-in sessions. Empty: Vitrine makes one on the first start and keeps it in the data
# volume. Changing it signs every staff member out of /manage/ (guests and tablets aren't affected).
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=*
# Only if signing in to /manage/ fails with a CSRF error behind your proxy:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://vitrine.example.org
# Frame rate of your vMix project; videos are converted to it.
# VITRINE_VIDEO_FPS=25
# Seconds between filmstrip frames in the cue panel.
# VITRINE_FILMSTRIP_INTERVAL=5
# Largest upload in MB; days a deleted file stays in the trash; days ahead a vMix PC downloads.
# VITRINE_MAX_UPLOAD_MB=4096
# VITRINE_TRASH_DAYS=30
# VITRINE_PRESYNC_DAYS=14

# ---------- Old way (still works, only used where Settings is left empty) ----------
# VITRINE_TELEGRAM_BOT_TOKEN=
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=
# VITRINE_OFFLINE_ALERT_MINUTES=10
# VITRINE_SYNC_CHECK_TIME=18:00
# VITRINE_BACKUP_TARGET=
# VITRINE_BACKUP_TIME=03:30
# VITRINE_BACKUP_KEEP_DAYS=14
# rclone remotes for VITRINE_BACKUP_TARGET (e.g. s3:vitrine-backup); in Settings, paste them instead:
# RCLONE_CONFIG_S3_TYPE=s3
# RCLONE_CONFIG_S3_PROVIDER=Other
# RCLONE_CONFIG_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# RCLONE_CONFIG_S3_ACCESS_KEY_ID=
# RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
